{
  "name": "pi-sm",
  "version": "0.1.0",
  "description": "Lite session manager for the pi coding agent — a TUI to browse, search, rename, fork, hide, and delete sessions, plus a /rn command.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "session-manager",
    "session",
    "tui",
    "rename"
  ],
  "license": "MIT",
  "author": "Wellington Mendoza <wellsaint91@gmail.com>",
  "homepage": "https://github.com/well1791/pi-sm",
  "repository": {
    "type": "git",
    "url": "https://github.com/well1791/pi-sm.git"
  },
  "bugs": {
    "url": "https://github.com/well1791/pi-sm/issues"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release:dry": "semantic-release --dry-run --no-ci",
    "setup:hooks": "simple-git-hooks"
  },
  "pi": {
    "extensions": [
      "./src/index.ts",
      "./src/rename.ts"
    ]
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.8",
    "simple-git-hooks": "^2.13.1",
    "typescript": "6",
    "typescript-eslint": "^8.65.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write --loglevel error",
      "eslint --fix --quiet"
    ]
  }
}

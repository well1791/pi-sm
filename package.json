  "author": "Wellington Mendoza <wellsaint91@gmail.com>",
  "homepage": "https://github.com/well1791/pi-sm",
  "repository": {
    "type": "git",
    "url": "https://github.com/well1791/pi-sm.git"
  },
  "bugs": {
    "url": "https://github.com/well1791/pi-sm/issues"
  },
  "pi": {
    "extensions": [
      "./src/index.ts",
      "./src/rename.ts"
    ]
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
